<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Groups: no frame around the expanded content (the rows have their own cards) -->
  <Styles.Resources>
    <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
    <Thickness x:Key="ExpanderContentUpBorderThickness">0</Thickness>
    <Thickness x:Key="ExpanderContentLeftBorderThickness">0</Thickness>
    <Thickness x:Key="ExpanderContentRightBorderThickness">0</Thickness>
    <Thickness x:Key="ExpanderContentPadding">0,2,0,0</Thickness>
    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent"/>
  </Styles.Resources>

  <!-- Text -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource CmText}"/>
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource CmText}"/>
    <Setter Property="Margin" Value="2,0,0,10"/>
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource CmTextMuted}"/>
    <Setter Property="Margin" Value="0,12,0,5"/>
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource CmTextMuted}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource CmErrText}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- Cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CmSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CmBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="18"/>
    <Setter Property="Margin" Value="0,0,0,18"/>
    <Setter Property="BoxShadow" Value="0 1 3 0 #14000000"/>
  </Style>
  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="{DynamicResource CmSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CmBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="24,22"/>
    <Setter Property="BoxShadow" Value="0 12 40 0 #40000000"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="16"/>
  </Style>
  <Style Selector="Border.overlay">
    <Setter Property="Background" Value="{DynamicResource CmOverlay}"/>
  </Style>

  <!-- Connection rows -->
  <Style Selector="Border.row">
    <Setter Property="Background" Value="{DynamicResource CmSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CmBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{DynamicResource CmRowHover}"/>
  </Style>
  <Style Selector="Border.row.selected">
    <Setter Property="Background" Value="{DynamicResource CmRowSelected}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CmRowSelectedBorder}"/>
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Width" Value="38"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="CornerRadius" Value="9"/>
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Height" Value="10"/>
    <Setter Property="Fill" Value="{StaticResource CmOffline}"/>
  </Style>
  <Style Selector="Ellipse.dot.online">
    <Setter Property="Fill" Value="{StaticResource CmOnline}"/>
  </Style>

  <!-- Buttons (Fluent's built-in "accent" class is the blue primary button) -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="14,7"/>
  </Style>
  <Style Selector="Button.toolbar">
    <Setter Property="Padding" Value="12,7"/>
  </Style>
  <Style Selector="Button.deletebig">
    <Setter Property="Background" Value="#C62828"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.deletebig:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#A61F1F"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource CmTextMuted}"/>
  </Style>
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="12"/>
    <Setter Property="Height" Value="12"/>
  </Style>
  <Style Selector="Button.header">
    <Setter Property="Background" Value="#26FFFFFF"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="Button.header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#40FFFFFF"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox, AutoCompleteBox">
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource CmText}"/>
  </Style>

  <!-- Tabs: compact headers like a desktop app -->
  <Style Selector="TabControl">
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="14.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="MinHeight" Value="42"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="Foreground" Value="{DynamicResource CmTextMuted}"/>
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource CmText}"/>
  </Style>

  <!-- Group headers -->
  <Style Selector="Expander">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0,6,0,0"/>
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="4,0"/>
  </Style>
  <Style Selector="Expander /template/ Border#ExpanderContent">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0,2,0,0"/>
  </Style>

  <!-- Plain (secondary) buttons: white with a thin border, like the rows -->
  <Style Selector="Button:not(.accent):not(.icon):not(.header):not(.deletebig)">
    <Setter Property="Background" Value="{DynamicResource CmSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CmBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource CmText}"/>
  </Style>
  <Style Selector="Button:not(.accent):not(.icon):not(.header):not(.deletebig):pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CmRowHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CmRowSelectedBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource CmText}"/>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource CmErrText}"/>
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CmErrBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CmErrText}"/>
    <Setter Property="Foreground" Value="{DynamicResource CmErrText}"/>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.55"/>
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CmBorder}"/>
  </Style>
</Styles>
